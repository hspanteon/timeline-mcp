# Panteon Authentication Settings
# Copy this file to .env and fill in your authentication credentials.
# You can obtain these by inspecting browser network requests to timeline.panteon.no in Chrome DevTools.

# Option 1: Bearer Token (Recommended)
# Copy the JWT token starting with eyJ... from the Authorization header or localStorage
PANTEON_BEARER_TOKEN=your_jwt_bearer_token_here

# Option 2: Cookie Header String
# If Bearer token is not sufficient, provide the raw Cookie header string from your browser session
PANTEON_COOKIE=your_raw_cookie_string_here

# Optional: XSRF Token if required by API endpoints
PANTEON_XSRF_TOKEN=your_xsrf_token_here

# Optional: Tenant / Company ID parameter used in API URLs (default is 16)
PANTEON_COMPANY_ID=16
