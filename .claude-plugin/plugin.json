{
  "name": "panteon-timeline",
  "version": "0.1.0",
  "description": "Fetch Panteon Timeline tasks (description + conversation + images) and turn them into a repo-aware SPEC before any work starts.",
  "author": {
    "name": "Panteon"
  },
  "mcpServers": {
    "timeline-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--with-requirements",
        "${CLAUDE_PLUGIN_ROOT}/requirements.txt",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/server.py"
      ],
      "env": {
        "PANTEON_BEARER_TOKEN": "${PANTEON_BEARER_TOKEN:-}",
        "PANTEON_COOKIE": "${PANTEON_COOKIE:-}",
        "PANTEON_XSRF_TOKEN": "${PANTEON_XSRF_TOKEN:-}"
      }
    }
  }
}
